{
  "name": "gamelink-host",
  "version": "4.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gamelink.host",
    "productName": "GameLink-Host",
    "files": [
      "**/*",
      "!dist${/*}",
      "!build${/*}",
      "!*.md",
      "!renderer.bundle.js*"
    ],
    "asarUnpack": [
      "input-bridge.ps1",
      "sysinfo-bridge.ps1"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "GameLink-Host-Portable.exe",
      "unpackDirName": "GameLink-Host"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "GameLink-Host-Kurulum.exe",
      "shortcutName": "GameLink-Host",
      "uninstallDisplayName": "GameLink-Host"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://sizin-domaininiz.com/updates/host/"
      }
    ]
  }
}
