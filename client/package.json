{
  "name": "gamelink-client",
  "version": "2.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.gamelink.client",
    "productName": "GameLink",
    "files": [
      "**/*",
      "!node_modules/electron-builder${/*}"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "portable": {
      "artifactName": "GameLink-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallDir": true,
      "artifactName": "GameLink-Kurulum.exe"
    }
  }
}
